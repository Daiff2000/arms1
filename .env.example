# Server configuration
PORT=3000

# Optional PostgreSQL connection string (when omitted, ARMS uses a local JSON store)
DATABASE_URL=

# Optional session signing secret (32+ characters recommended in production)
ARMS_SESSION_SECRET=

# Optional initial administrator bootstrap credentials
ARMS_ADMIN_USERNAME=admin
ARMS_ADMIN_PASSWORD=
ARMS_ADMIN_NAME=System Administrator

# Optional one-time setup key (used when PostgreSQL is empty and env admin is omitted)
ARMS_SETUP_SECRET=
